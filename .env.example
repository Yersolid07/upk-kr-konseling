# =====================================================
# UPK-Kr. Konseling — Environment Variables
# Copy this to .env.local and fill in your values
# =====================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-side only, NEVER expose to client

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=UPK-Kr. Konseling

# Email (Resend or SMTP via Supabase)
RESEND_API_KEY=re_xxxx

# Push Notifications (Web Push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# WhatsApp / Telegram (optional, via Fonnte or WA Business API)
FONNTE_TOKEN=your-fonnte-token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# SOS Alert phone number (WhatsApp for konselor piket)
NEXT_PUBLIC_SOS_WA_NUMBER=628xxxxxxxxxxxx
NEXT_PUBLIC_SOS_HOTLINE=119
