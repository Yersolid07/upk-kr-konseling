# ============================================================
# IKA UPK-Kr FT UNSRAT — Environment Variables (EXAMPLE / TEMPLATE)
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in REAL values.
#   cp .env.example .env.local
# NEVER commit `.env.local` (it is git-ignored). Never paste real
# keys into this template file.
# ============================================================

# ---- Supabase (Project Settings -> API) --------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser. Rotate if ever leaked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ---------------------------------------------------
# Opsional. Alamat publik diturunkan otomatis dari header permintaan
# (x-forwarded-host), jadi variabel ini TIDAK wajib di Vercel. Setel hanya bila
# ingin memaksa satu domain kanonik (mis. di belakang proxy sendiri).
# APP_URL=https://upk-kr-konseling.vercel.app
NEXT_PUBLIC_APP_NAME=IKA UPK-Kr FT UNSRAT

# ---- Email (Resend) ----------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ---- Push Notifications (Web Push / VAPID) -----------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# ---- WhatsApp / Telegram (optional: Fonnte or WA Business) -
FONNTE_TOKEN=your-fonnte-token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ---- SOS / Emergency contacts ------------------------------
NEXT_PUBLIC_SOS_WA_NUMBER=628xxxxxxxxxx
NEXT_PUBLIC_SOS_HOTLINE=119
